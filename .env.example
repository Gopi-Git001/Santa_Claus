# Copied to .env (git-ignored) by `node scripts/bootstrap.ts`, which replaces
# every __GENERATED__ value with a fresh random value. Never commit .env.
# The full, validated variable schema lives in packages/config/src/config.ts (ENV_SCHEMA).

HARNESS_ENV=development

# docker compose (infra/dev/docker-compose.yml)
HARNESS_DB_USER=harness
HARNESS_DB_NAME=harness_dev
HARNESS_DB_PORT=55432
HARNESS_DB_PASSWORD=__GENERATED__

# harness runtime (secret; assembled by bootstrap from the values above)
DATABASE_URL=__GENERATED__

HARNESS_ARTIFACT_ROOT=.data/artifacts
HARNESS_LOG_LEVEL=info
HARNESS_CHECKPOINT_SCHEMA=harness_checkpoints
HARNESS_FF_INTERRUPT_DEMO=true
HARNESS_MAX_GRAPH_STEPS=25

{
  "$id": "urn:harness:schema:AgentSpec:v1",
  "title": "AgentSpec",
  "x-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "parent_agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    },
    "context_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      }
    },
    "denied_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      }
    },
    "workspace_scope": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "read",
            "read_write"
          ]
        },
        "roots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "mode",
        "roots"
      ],
      "additionalProperties": false
    },
    "network_scope": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "allowlist"
          ]
        },
        "hosts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "mode",
        "hosts"
      ],
      "additionalProperties": false
    },
    "secret_scope": {
      "type": "object",
      "properties": {
        "secret_refs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "secret_ref"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "env"
                ]
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": [
              "kind",
              "provider",
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "secret_refs"
      ],
      "additionalProperties": false
    },
    "memory_scope": {
      "type": "object",
      "properties": {
        "namespaces": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "namespaces"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_wall_clock_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_cost_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_steps",
        "max_wall_clock_ms",
        "max_tokens",
        "max_cost_micro_usd"
      ],
      "additionalProperties": false
    },
    "delegation_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    },
    "approval_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    },
    "verification_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    },
    "lifecycle_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "agent_id",
    "run_id",
    "role",
    "objective",
    "success_criteria",
    "model_policy",
    "context_policy",
    "allowed_capabilities",
    "denied_capabilities",
    "workspace_scope",
    "network_scope",
    "secret_scope",
    "memory_scope",
    "budget",
    "delegation_policy",
    "approval_policy",
    "verification_policy",
    "lifecycle_policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}

{
  "$id": "urn:harness:schema:EventEnvelope:v1",
  "title": "EventEnvelope",
  "x-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "schema_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run.created",
        "run.status_changed",
        "graph.started",
        "graph.node_started",
        "graph.node_completed",
        "graph.interrupted",
        "graph.resumed",
        "graph.failed",
        "graph.completed",
        "artifact.created",
        "policy.decision_recorded",
        "test.evidence_recorded"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^thr_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^tsk_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {}
  },
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "timestamp",
    "run_id",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false
}

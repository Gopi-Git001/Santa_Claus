{
  "$id": "urn:harness:schema:ProposedAction:v1",
  "title": "ProposedAction",
  "x-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "harness",
            "graph_node",
            "agent",
            "human",
            "test"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "risk_context": {
      "type": "object",
      "properties": {
        "side_effect_class": {
          "type": "string",
          "enum": [
            "none",
            "read_only",
            "local_write",
            "external_write",
            "irreversible"
          ]
        },
        "input_trust": {
          "type": "string",
          "enum": [
            "trusted",
            "harness",
            "user",
            "untrusted"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "side_effect_class",
        "input_trust"
      ],
      "additionalProperties": false
    },
    "estimated_budget": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_wall_clock_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_cost_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "actor",
    "capability",
    "operation",
    "arguments",
    "target",
    "risk_context",
    "estimated_budget"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}

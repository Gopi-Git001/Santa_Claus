{
  "$id": "urn:harness:schema:Task:v1",
  "title": "Task",
  "x-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^tsk_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "owner_agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tsk_[0-9a-hjkmnp-tv-z]{26}$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "success_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_wall_clock_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_cost_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_steps",
        "max_wall_clock_ms",
        "max_tokens",
        "max_cost_micro_usd"
      ],
      "additionalProperties": false
    },
    "verification_policy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "profile",
        "params"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "run_id",
    "objective",
    "dependencies",
    "status",
    "priority",
    "success_criteria",
    "budget",
    "verification_policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
